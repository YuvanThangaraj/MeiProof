# Backend-only configuration. Keep real values in ignored backend/.env.
MEIPROOF_ENV=development
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<copy-from-project-api-keys>
SUPABASE_SECRET_KEY=sb_secret_<backend-only-secret>

STORAGE_BUCKET=claim-evidence
DEMO_MODE=false
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
DEMO_LOGIN_USER_ID=
OCR_ENABLED=true
TESSERACT_CMD=
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# Legacy key names are also accepted when using anon/service_role JWT keys.
# SUPABASE_ANON_KEY=<legacy-anon-jwt>
# SUPABASE_SERVICE_ROLE_KEY=<legacy-service-role-jwt>
