# Copy to .env.local and set the public values from the Supabase Project Connect panel.
# Never place a database password, service_role key, or secret key in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8000
# Set true to show the local demo-login toggle, including alongside Supabase Auth.
VITE_DEMO_MODE=true
VITE_DEMO_ACCOUNT_ENABLED=false
